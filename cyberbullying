  </footer>

  <!-- SCRIPT DE ACESSIBILIDADE (FONTE E CONTRASTE) -->
  <script>
    let fontFactor = 1;

    function alterarFonte(delta) {
      fontFactor += delta * 0.1;
      if (fontFactor < 0.8) fontFactor = 0.8;
      if (fontFactor > 1.5) fontFactor = 1.5;
      document.documentElement.style.fontSize = (16 * fontFactor) + 'px';
    }

    function resetarFonte() {
      fontFactor = 1;
      document.documentElement.style.fontSize = '16px';
    }

    function toggleContraste() {
      document.body.classList.toggle('high-contrast');
    }
  </script>
</body>
</html>
